<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.servicebase.mapper.NewsMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.base.article.NewsPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="image" jdbcType="VARCHAR" property="image" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="outId" jdbcType="VARCHAR" property="outId" />
        <result column="release_date" jdbcType="VARCHAR" property="releaseDate" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>

    <resultMap id="NewsVOMap" type="com.ai.basecommon.core.vo.base.NewsVO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="image" jdbcType="VARCHAR" property="image" />
        <result column="release_date" jdbcType="VARCHAR" property="releaseDate" />
    </resultMap>
    <resultMap id="NewsDetailVOMap" type="com.ai.basecommon.core.vo.base.NewsDetailVO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="image" jdbcType="VARCHAR" property="image" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="release_date" jdbcType="VARCHAR" property="releaseDate" />
    </resultMap>



    <select id="select" resultMap="NewsVOMap">
        select id,title,image,release_date
        from tw_news
        order by id desc
        <if test="page != null and page != 0">
            limit #{begin},#{limit}
        </if>
    </select>


    <select id="findById" resultMap="NewsDetailVOMap">
        select id,title,image,content,release_date from tw_news where id = #{id}
    </select>



</mapper>
