<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.servicebase.mapper.AnnounMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.base.article.AnnounPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="image" jdbcType="VARCHAR" property="image" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
        <result column="release_time" jdbcType="BIGINT" property="releaseTime" />
    </resultMap>

    <resultMap id="AnnounVOMap" type="com.ai.basecommon.core.vo.base.AnnounVO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="title" jdbcType="VARCHAR" property="title" />
        <result column="image" jdbcType="VARCHAR" property="image" />
        <result column="content" jdbcType="VARCHAR" property="content" />
        <result column="release_time" jdbcType="BIGINT" property="releaseTime" />
    </resultMap>



    <select id="select" resultMap="AnnounVOMap">
        select id,title,image,content,release_time
        from tw_announ
        where status = 1
        order by release_time desc,id desc
        <if test="page != null and page != 0">
            limit #{begin},#{limit}
        </if>
    </select>


    <select id="findById" resultMap="AnnounVOMap">
        select id,title,image,content,release_time from tw_announ where status = 1 and id = #{id}
    </select>



</mapper>
