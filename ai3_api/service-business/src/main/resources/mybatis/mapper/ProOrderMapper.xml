	</resultMap>

	<resultMap id="MyProVOMap" type="com.ai.basecommon.core.vo.pro.MyProVO">
		<result column="order_id" jdbcType="VARCHAR" property="orderId" />
		<result column="title" jdbcType="VARCHAR" property="title" />
		<result column="image" jdbcType="VARCHAR" property="image" />
		<result column="pay_amount" jdbcType="DECIMAL" property="payAmount" />
		<result column="status" jdbcType="INTEGER" property="status" />
		<result column="create_time" jdbcType="BIGINT" property="createTime" />
	</resultMap>

	<resultMap id="MyProDetailVOMap" type="com.ai.basecommon.core.vo.pro.MyProDetailVO">
		<result column="title" jdbcType="VARCHAR" property="title" />
		<result column="image" jdbcType="VARCHAR" property="image" />
		<result column="pay_amount" jdbcType="DECIMAL" property="payAmount" />
		<result column="total_take_amount" jdbcType="DECIMAL" property="totalTakeAmount" />
		<result column="total_fee" jdbcType="DECIMAL" property="totalFee" />
		<result column="total_earning" jdbcType="DECIMAL" property="totalEarning" />
		<result column="put_days" jdbcType="INTEGER" property="putDays" />
		<result column="cate_type" jdbcType="INTEGER" property="cateType" />
		<result column="price" jdbcType="DECIMAL" property="price" />
		<result column="check_type" jdbcType="INTEGER" property="checkType" />
