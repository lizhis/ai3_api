		<result column="give_quota_amount" jdbcType="INTEGER" property="giveQuotaAmount" />
		<result column="give_quota_is_active" jdbcType="INTEGER" property="giveQuotaIsActive" />
		<result column="total_take_num" jdbcType="INTEGER" property="totalTakeNum" />
		<result column="total_take_amount" jdbcType="DECIMAL" property="totalTakeAmount" />
		<result column="total_fee" jdbcType="DECIMAL" property="totalFee" />
