		<result column="start_time" jdbcType="BIGINT" property="startTime" />
		<result column="end_time" jdbcType="BIGINT" property="endTime" />
	</resultMap>


	<insert id="insertGetId" useGeneratedKeys="true" keyProperty="id">
		insert into tw_pro_order (order_id,user_id,real_name,pro_id,title,image,take_amount_min,take_amount_max,income_floor,extra_num_min,extra_num_max,fee_rate,put_days,remark,content,cate_type,price,pay_amount,give_goods_type,give_shop,give_shop_desc,give_amount,give_desc,give_quota_amount, give_quota_is_active,check_type,is_auto_next,ymd,start_time,end_time,create_time,update_time)
		values (#{orderId},#{userId},#{realName},#{proId},#{title},#{image},#{takeAmountMin},#{takeAmountMax},#{incomeFloor},#{extraNumMin},#{extraNumMax},#{feeRate},#{putDays},#{remark},#{content},#{cateType},#{price},#{payAmount},#{giveGoodsType},#{giveShop},#{giveShopDesc},#{giveAmount},#{giveDesc},#{giveQuotaAmount},#{giveQuotaIsActive},#{checkType},#{isAutoNext},#{ymd},#{startTime},#{endTime},#{createTime}, #{updateTime})
	</insert>


	<select id="findByOrderId" resultMap="BaseResultMap">
		select * from tw_pro_order where order_id = #{orderId}
	</select>

	<select id="myList" resultMap="MyProVOMap">
		select order_id,title,image,pay_amount,status,create_time
		from tw_pro_order
		where user_id = #{userId} and status = #{status}
		order by create_time desc
	</select>

	<select id="myDetail" resultMap="MyProDetailVOMap">
		select title,image,pay_amount,total_take_amount,total_fee,total_earning,put_days,cate_type,check_type,is_auto_next,status,create_time,start_time,end_time
		from tw_pro_order
		where user_id = #{userId} and order_id = #{orderId}
	</select>

	<select id="countByUserIdAndProId" resultType="int">
		select count(*) from tw_pro_order where user_id = #{userId} and pro_id = #{proId}
	</select>

	<select id="countByYmdAndUserIdAndPileId" resultType="int">
		select count(*) from tw_pro_order where ymd = #{ymd} and user_id = #{userId} and pro_id = #{proId}
	</select>



</mapper>
