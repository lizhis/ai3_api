<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.servicebusiness.mapper.UserPassMapper">


	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserPassPO">
		<result column="user_id" jdbcType="BIGINT" property="userId" />
		<result column="password" jdbcType="VARCHAR" property="password" />
		<result column="password_pay" jdbcType="VARCHAR" property="passwordPay" />
	</resultMap>


	<select id="findByUserId" resultMap="BaseResultMap">
		select * from tw_user_pass where user_id = #{userId}
	</select>


</mapper>
