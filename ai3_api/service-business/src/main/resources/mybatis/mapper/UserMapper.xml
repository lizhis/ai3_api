<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.servicebusiness.mapper.UserMapper">


	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserPO">
		<result column="user_id" jdbcType="BIGINT" property="userId" />
		<result column="tel" jdbcType="VARCHAR" property="tel" />
		<result column="nickname" jdbcType="VARCHAR" property="nickname" />
		<result column="avatar" jdbcType="VARCHAR" property="avatar" />
		<result column="level" jdbcType="INTEGER" property="level" />
		<result column="invite_user_id" jdbcType="BIGINT" property="inviteUserId" />
		<result column="pass_level" jdbcType="INTEGER" property="passLevel" />
		<result column="channel" jdbcType="INTEGER" property="channel" />
		<result column="register_ip" jdbcType="VARCHAR" property="registerIp" />
		<result column="register_addr" jdbcType="VARCHAR" property="registerAddr" />
		<result column="real_name" jdbcType="VARCHAR" property="realName" />
		<result column="idcard" jdbcType="VARCHAR" property="idcard" />
		<result column="auth_status" jdbcType="INTEGER" property="authStatus" />
		<result column="newbie_status" jdbcType="INTEGER" property="newbieStatus" />
		<result column="status" jdbcType="INTEGER" property="status" />
		<result column="is_del" jdbcType="INTEGER" property="isDel" />
		<result column="last_login_ip" jdbcType="VARCHAR" property="lastLoginIp" />
		<result column="last_login_addr" jdbcType="VARCHAR" property="lastLoginAddr" />
		<result column="last_login_time" jdbcType="BIGINT" property="lastLoginTime" />
		<result column="last_enter_time" jdbcType="BIGINT" property="lastEnterTime" />
		<result column="is_online" jdbcType="INTEGER" property="isOnline" />
		<result column="create_time" jdbcType="BIGINT" property="createTime" />
		<result column="update_time" jdbcType="BIGINT" property="updateTime" />
	</resultMap>


	<select id="findByUserId" resultMap="BaseResultMap">
		select * from tw_user where user_id = #{userId} and is_del = 0;
	</select>




</mapper>
