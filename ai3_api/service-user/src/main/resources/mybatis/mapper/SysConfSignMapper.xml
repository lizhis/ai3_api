<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.SysConfSignMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.base.SysConfSignPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="days" jdbcType="INTEGER" property="days" />
        <result column="amount" jdbcType="DECIMAL" property="amount" />
        <result column="give_type" jdbcType="INTEGER" property="giveType" />
        <result column="type" jdbcType="INTEGER" property="type" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>

    <select id="select" resultMap="BaseResultMap">
        select * from tw_sys_conf_sign order by days asc
    </select>

    <select id="findByDaysAndType" resultMap="BaseResultMap">
        select * from tw_sys_conf_sign where days = #{days} and type = #{type} limit 1
    </select>



</mapper>
