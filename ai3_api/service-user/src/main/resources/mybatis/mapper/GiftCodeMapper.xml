<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.GiftCodeMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.shop.GiftCodePO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="code" jdbcType="VARCHAR" property="code" />
        <result column="user_id" jdbcType="BIGINT" property="userId" />
        <result column="day_num" jdbcType="INTEGER" property="dayNum" />
        <result column="max_num" jdbcType="INTEGER" property="maxNum" />
        <result column="use_num" jdbcType="INTEGER" property="useNum" />
        <result column="remark" jdbcType="VARCHAR" property="remark" />
        <result column="source" jdbcType="INTEGER" property="source" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>


    <insert id="insert">
        insert into tw_gift_code (code,user_id,day_num,max_num,remark,source,create_time,update_time)
        values (#{code},#{userId},#{dayNum},#{maxNum},#{remark},#{source},#{createTime}, #{updateTime})
    </insert>

    <select id="countByCode" resultType="int">
        select count(1) from tw_gift_code where code = #{code}
    </select>

    <select id="findLastForInvite" resultMap="BaseResultMap">
        select * from tw_gift_code where user_id = #{userId} and source = 2 order by id desc limit 1
    </select>


    <select id="countByUserSource" resultType="int">
        select count(1) from tw_gift_code where user_id = #{userId} and source = #{source}
    </select>




</mapper>
