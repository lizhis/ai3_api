<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.UserPassMapper">


	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserPassPO">
		<result column="user_id" jdbcType="BIGINT" property="userId" />
		<result column="password" jdbcType="VARCHAR" property="password" />
		<result column="password_pay" jdbcType="VARCHAR" property="passwordPay" />
	</resultMap>


	<insert id="insert">
		insert into tw_user_pass (user_id,password)
		values (#{userId},#{password})
  	</insert>

	<select id="findByUserId" resultMap="BaseResultMap">
		select * from tw_user_pass where user_id = #{userId}
	</select>

	<update id="updatePass">
		update tw_user_pass set password = #{password} where user_id = #{userId}
	</update>

	<update id="updatePassPay">
		update tw_user_pass set password_pay = #{passwordPay} where user_id = #{userId}
	</update>


</mapper>
