<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.UserDataDayMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserDataDayPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="user_id" jdbcType="BIGINT" property="userId" />
        <result column="step" jdbcType="INTEGER" property="step" />
        <result column="ymd" jdbcType="INTEGER" property="ymd" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>


    <select id="find" resultMap="BaseResultMap">
        select * from tw_user_data_day where user_id = #{userId} and ymd = #{ymd}
    </select>



</mapper>
