<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.WithdrawMapper">

	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.WithdrawPO">
		<result column="id" jdbcType="BIGINT" property="id" />
		<result column="withdraw_id" jdbcType="VARCHAR" property="withdrawId" />
		<result column="user_id" jdbcType="BIGINT" property="userId" />
		<result column="receiver" jdbcType="VARCHAR" property="receiver" />
		<result column="bank_name" jdbcType="VARCHAR" property="bankName" />
		<result column="card_no" jdbcType="VARCHAR" property="cardNo" />
		<result column="amount" jdbcType="DECIMAL" property="amount" />
		<result column="type" jdbcType="INTEGER" property="type" />
		<result column="is_small_quota" jdbcType="INTEGER" property="isSmallQuota" />
		<result column="reason" jdbcType="VARCHAR" property="reason" />
		<result column="status" jdbcType="INTEGER" property="status" />
		<result column="create_time" jdbcType="BIGINT" property="createTime" />
		<result column="update_time" jdbcType="BIGINT" property="updateTime" />
		<result column="finish_time" jdbcType="BIGINT" property="finishTime" />
	</resultMap>


	<insert id="insert">
		insert into tw_withdraw (withdraw_id,user_id,receiver,bank_name,card_no,amount,type,is_small_quota,status,create_time,update_time)
		values (#{withdrawId},#{userId},#{receiver},#{bankName},#{cardNo},#{amount},#{type},#{isSmallQuota},#{status},#{createTime}, #{updateTime})
	</insert>





</mapper>
