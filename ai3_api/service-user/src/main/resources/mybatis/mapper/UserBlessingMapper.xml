<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.UserBlessingMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserBlessingPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="user_id" jdbcType="BIGINT" property="userId" />
        <result column="blessing_type" jdbcType="INTEGER" property="blessingType" />
        <result column="order_id" jdbcType="VARCHAR" property="orderId" />
        <result column="ymd" jdbcType="INTEGER" property="ymd" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>


    <select id="countByUserIdPassInvite" resultType="int">
         select count(*) from tw_user_blessing where user_id = #{userId} and blessing_type != 6
    </select>

    <select id="countByUserIdInviteCard" resultType="int">
         select count(*) from tw_user_blessing where user_id = #{userId} and blessing_type = 6 and status = 1
    </select>

    <select id="selectIdsInviteCard" resultType="Long">
         select id from tw_user_blessing where user_id = #{userId} and blessing_type = 6 and status = 1
    </select>


    <select id="existCard" resultType="int">
         select count(*) from tw_user_blessing where user_id = #{userId} and blessing_type = #{blessingType} and status = 1
    </select>

    <select id="selectTypeByUserIdPassInvite" resultType="int">
         select blessing_type from tw_user_blessing where user_id = #{userId} and blessing_type != 6
    </select>


    <insert id="insert">
        insert into tw_user_blessing (user_id,blessing_type,ymd,create_time,update_time)
        values (#{userId},#{blessingType},#{ymd},#{createTime}, #{updateTime})
    </insert>


    <update id="decInviteCard" parameterType="java.util.List">
        update tw_user_blessing set status = 2
        where id in
        <foreach collection="list" index="index" item="item" separator="," open="(" close=")">
            #{item}
        </foreach>
    </update>



</mapper>
