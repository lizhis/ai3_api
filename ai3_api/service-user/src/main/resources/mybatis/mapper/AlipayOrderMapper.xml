<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.AlipayOrderMapper">


	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.base.AlipayOrderPO">
		<result column="id" jdbcType="BIGINT" property="id" />
		<result column="user_id" jdbcType="BIGINT" property="userId" />
		<result column="order_id" jdbcType="VARCHAR" property="orderId" />
		<result column="total_amount" jdbcType="DECIMAL" property="totalAmount" />
		<result column="goods_name" jdbcType="VARCHAR" property="goodsName" />
		<result column="app_id" jdbcType="VARCHAR" property="appId" />
		<result column="trade_no" jdbcType="VARCHAR" property="tradeNo" />
		<result column="receipt_amount" jdbcType="DECIMAL" property="receiptAmount" />
		<result column="pay_account" jdbcType="VARCHAR" property="payAccount" />
		<result column="pay_status" jdbcType="VARCHAR" property="payStatus" />
		<result column="pay_time_str" jdbcType="VARCHAR" property="payTimeStr" />
		<result column="pay_time" jdbcType="BIGINT" property="payTime" />
		<result column="business_type" jdbcType="INTEGER" property="businessType" />
		<result column="pay_way" jdbcType="INTEGER" property="payWay" />
		<result column="status" jdbcType="INTEGER" property="status" />
		<result column="channel_remark" jdbcType="VARCHAR" property="channelRemark" />
		<result column="create_time" jdbcType="BIGINT" property="createTime" />
		<result column="update_time" jdbcType="BIGINT" property="updateTime" />
	</resultMap>


	<insert id="insert">
		insert into tw_alipay_order (user_id,order_id,total_amount,goods_name,business_type,pay_way,channel_remark,create_time,update_time)
		values (#{userId},#{orderId},#{totalAmount},#{goodsName},#{businessType},#{payWay},#{channelRemark},#{createTime}, #{updateTime})
	</insert>




</mapper>
