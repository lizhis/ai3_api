<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.DeviceSecretMapper">


	<resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.DeviceSecretPO">
		<result column="id" jdbcType="BIGINT" property="id" />
		<result column="device_id" jdbcType="VARCHAR" property="deviceId" />
		<result column="secret" jdbcType="VARCHAR" property="secret" />
		<result column="ymd" jdbcType="INTEGER" property="ymd" />
		<result column="create_time" jdbcType="BIGINT" property="createTime" />
		<result column="update_time" jdbcType="BIGINT" property="updateTime" />
	</resultMap>

	<insert id="insert">
		insert into tw_device_secret (device_id,secret,ymd,create_time,update_time)
		values (#{deviceId},#{secret},#{ymd},#{createTime}, #{updateTime})
	</insert>

	<select id="countByDeviceId" resultType="int">
		select count(1) from tw_device_secret where device_id = #{deviceId}
	</select>

	<select id="findSecretByDeviceId" resultType="String">
		select secret from tw_device_secret where device_id = #{deviceId}
	</select>

	<delete id="deleteByDeviceId">
		delete from tw_device_secret where device_id = #{deviceId}
	</delete>




</mapper>
