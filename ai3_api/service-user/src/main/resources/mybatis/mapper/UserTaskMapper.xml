<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ai.serviceuser.mapper.UserTaskMapper">

    <resultMap id="BaseResultMap" type="com.ai.basecommon.core.po.user.UserTaskPO">
        <result column="id" jdbcType="BIGINT" property="id" />
        <result column="user_id" jdbcType="BIGINT" property="userId" />
        <result column="task_id" jdbcType="BIGINT" property="taskId" />
        <result column="progress" jdbcType="INTEGER" property="progress" />
        <result column="status" jdbcType="INTEGER" property="status" />
        <result column="ymd" jdbcType="INTEGER" property="ymd" />
        <result column="create_time" jdbcType="BIGINT" property="createTime" />
        <result column="update_time" jdbcType="BIGINT" property="updateTime" />
    </resultMap>



    <select id="findLast" resultMap="BaseResultMap">
        select * from tw_user_task where user_id = #{userId} order by id desc limit 1
    </select>

    <select id="findLastGold" resultMap="BaseResultMap">
        select * from tw_user_task where user_id = #{userId} and gold &gt; 0 order by id desc limit 1
    </select>


    <select id="countByUserId" resultType="int">
        select count(1) from tw_user_task where user_id = #{userId}
    </select>

    <select id="countPassId" resultType="int">
        select count(1) from tw_user_task where user_id = #{userId} and id &gt; #{id}
    </select>



    <select id="selectByUserIdTaskIds" resultMap="BaseResultMap">
        select * from tw_user_task
        where user_id = #{userId} and task_id in
        <foreach collection="ids" index="index" item="item" separator="," open="(" close=")">
            #{item,jdbcType=BIGINT}
        </foreach>
    </select>

    <select id="countFinishByDays" resultType="int">
        SELECT COUNT(1) FROM tw_user_task WHERE days = #{days} AND user_id = #{userId} AND status = 1
    </select>

    <delete id="delete">
        delete from tw_user_task where id = #{id}
    </delete>

</mapper>
